{
  "name": "@comicspace/server",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@comicspace/contracts": "workspace:*",
    "@comicspace/plugin-sdk": "workspace:*",
    "@hono/node-server": "^2.1.5",
