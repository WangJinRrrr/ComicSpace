# API server
HOST=127.0.0.1
PORT=4000
# Browser origin allowed to call the API in development
WEB_ORIGIN=http://127.0.0.1:5173

# Runtime paths (defaults are relative to the repo root)
# COMICSPACE_DATA_DIR=./data
# COMICSPACE_PLUGINS_DIR=./plugins
# COMICSPACE_WEB_DIST=./apps/web/dist

# Comma-separated hostnames allowed to use private/LAN addresses in the image proxy.
# Example: COMICSPACE_IMAGE_ALLOW_HOSTS=127.0.0.1:8787,192.168.1.20
# COMICSPACE_IMAGE_ALLOW_HOSTS=

# Read cache limit in MiB (default 1024, min 128, max 10240)
# COMICSPACE_CACHE_LIMIT_MB=1024

# Global HTTP(S) proxy used by plugin requests (when the plugin has no proxyUrl
# of its own), chapter images, and downloads. Empty or unset means direct.
# Only http:// and https:// proxies are supported.
# COMICSPACE_PROXY_URL=http://127.0.0.1:7890
